# Maintainer: Mysttic <19372942+Mysttic@users.noreply.github.com>
# Generated by the Release workflow of https://github.com/Mysttic/simple-rest
# from packaging/aur/PKGBUILD.in: change it there, not here.
pkgname=simple-rest-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='REST and TCP client in one file, with its UI in the browser'
arch=('x86_64' 'aarch64' 'armv7h')
url='https://github.com/Mysttic/simple-rest'
license=('MIT')
provides=('simple-rest')
conflicts=('simple-rest')
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/Mysttic/simple-rest/v$pkgver/LICENSE")
source_x86_64=("$url/releases/download/v$pkgver/simple-rest-$pkgver-linux-amd64")
source_aarch64=("$url/releases/download/v$pkgver/simple-rest-$pkgver-linux-arm64")
source_armv7h=("$url/releases/download/v$pkgver/simple-rest-$pkgver-linux-armhf")
sha256sums=('@SHA256_LICENSE@')
sha256sums_x86_64=('@SHA256_LINUX_AMD64@')
sha256sums_aarch64=('@SHA256_LINUX_ARM64@')
sha256sums_armv7h=('@SHA256_LINUX_ARMHF@')

package() {
  case "$CARCH" in
    x86_64) _platform=linux-amd64 ;;
    aarch64) _platform=linux-arm64 ;;
    armv7h) _platform=linux-armhf ;;
  esac
  install -Dm755 "simple-rest-$pkgver-$_platform" "$pkgdir/usr/bin/simple-rest"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
