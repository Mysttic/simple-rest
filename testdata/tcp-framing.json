    { "host": "10.0.0.5", "port": "65536", "error": "port" },
    { "host": "10.0.0.5", "port": "+2575", "error": "port" },
    { "host": "10.0.0.5", "port": "25a", "error": "port" },
    { "host": "10.0.0.5", "port": "2575.0", "error": "port" },
    { "host": "10.0.0.5", "port": "99999999999999999999", "error": "port" }
  ]
}
