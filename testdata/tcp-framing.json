{
  "about": [
    "Shared vectors of the framing of the TCP console: tcpframe.go and tcp.go here, and their twins in ui.html (tcpWrap, tcpTarget) once the page has the console.",
    "A change to either side comes with a vector here. Bytes are text in which each character is one byte (code points 0 to 255).",
    "presets: the start and end marker of each preset.",
    "wrap: a message, what goes on the wire with the preset and whether the framing was added.",
    "deframe: the reads of a connection, null for idleMs of silence, and the entries they make. The connection ends after the",
    "last read for the reason in close (peer closed when there is none). Every entry lists data and only the flags it has;",
    "maxFrame and maxOutside stand in for 1 MB and 64 KB. The Go test also feeds each run of reads whole, byte by byte and in random pieces.",
    "targets: the host and the port of a connection once the variables are in, and the address Connect dials, or which half is wrong."
  ],

  "presets": {
    "none": { "start": "", "end": "" },
    "lf": { "start": "", "end": "\n" },
    "crlf": { "start": "", "end": "\r\n" },
    "mllp": { "start": "\u000b", "end": "\u001c\r" },
    "stxetx": { "start": "\u0002", "end": "\u0003" }
  },

  "wrap": [
    { "preset": "none", "in": "abc", "out": "abc", "wrapped": false },
    { "preset": "none", "in": "", "out": "", "wrapped": false },
    { "preset": "lf", "in": "abc", "out": "abc\n", "wrapped": true },
    { "preset": "lf", "in": "abc\n", "out": "abc\n", "wrapped": false },
    { "preset": "lf", "in": "", "out": "\n", "wrapped": true },
    { "preset": "crlf", "in": "abc", "out": "abc\r\n", "wrapped": true },
    { "preset": "crlf", "in": "abc\r", "out": "abc\r\r\n", "wrapped": true },
    { "preset": "crlf", "in": "abc\n", "out": "abc\n\r\n", "wrapped": true },
    { "preset": "crlf", "in": "abc\r\n", "out": "abc\r\n", "wrapped": false },
    { "preset": "mllp", "in": "MSH|^~\\&|A\rPID|1\r", "out": "\u000bMSH|^~\\&|A\rPID|1\r\u001c\r", "wrapped": true },
    { "preset": "mllp", "in": "\u000bMSH|^~\\&|A\r\u001c\r", "out": "\u000bMSH|^~\\&|A\r\u001c\r", "wrapped": false },
    { "preset": "mllp", "in": "\u000bMSH\r", "out": "\u000b\u000bMSH\r\u001c\r", "wrapped": true },
    { "preset": "mllp", "in": "MSH\r\u001c\r", "out": "\u000bMSH\r\u001c\r\u001c\r", "wrapped": true },
    { "preset": "mllp", "in": "\u000b\u001c\r", "out": "\u000b\u001c\r", "wrapped": false },
    { "preset": "mllp", "in": "\u000b\u001c", "out": "\u000b\u000b\u001c\u001c\r", "wrapped": true },
    { "preset": "mllp", "in": "", "out": "\u000b\u001c\r", "wrapped": true },
    { "preset": "stxetx", "in": "\u0000ÿ\u0080", "out": "\u0002\u0000ÿ\u0080\u0003", "wrapped": true },
    { "preset": "stxetx", "in": "\u0002ab\u0003", "out": "\u0002ab\u0003", "wrapped": false }
  ],

  "deframe": [
    { "name": "none keeps every byte outside a frame", "preset": "none", "reads": ["abc", "def"],
      "want": [{ "data": "abcdef", "outside": true }] },
    { "name": "none splits on silence", "preset": "none", "reads": ["abc", null, "def"],
      "want": [{ "data": "abc", "outside": true }, { "data": "def", "outside": true }] },
    { "name": "none cuts outside bytes at maxOutside", "preset": "none", "maxOutside": 4, "reads": ["abcdefghij"],
      "want": [{ "data": "abcd", "outside": true }, { "data": "efgh", "outside": true }, { "data": "ij", "outside": true }] },
    { "name": "none with any byte", "preset": "none", "reads": ["\u0000ÿ\u0080\r\n"],
      "want": [{ "data": "\u0000ÿ\u0080\r\n", "outside": true }] },
    { "name": "lf lines, the last one unfinished", "preset": "lf", "reads": ["one\ntwo\nthr"],
      "want": [{ "data": "one\n" }, { "data": "two\n" }, { "data": "thr", "incomplete": "peer closed" }] },
    { "name": "lf never splits a frame on silence", "preset": "lf", "reads": ["par", null, "tial\n"],
      "want": [{ "data": "partial\n" }] },
    { "name": "crlf across reads, a lone CR inside", "preset": "crlf", "reads": ["a\r", "\nb\rc\r\n"],
      "want": [{ "data": "a\r\n" }, { "data": "b\rc\r\n" }] },
    { "name": "mllp two frames in one read", "preset": "mllp", "reads": ["\u000bA\u001c\r\u000bB\u001c\r"],
      "want": [{ "data": "\u000bA\u001c\r" }, { "data": "\u000bB\u001c\r" }] },
    { "name": "mllp 1C and 0D in separate reads", "preset": "mllp", "reads": ["\u000bMSH|^~\\&\r\u001c", "\r"],
      "want": [{ "data": "\u000bMSH|^~\\&\r\u001c\r" }] },
    { "name": "mllp garbage before 0B", "preset": "mllp", "reads": ["xy\u000bA\u001c\r"],
      "want": [{ "data": "xy", "outside": true }, { "data": "\u000bA\u001c\r" }] },
    { "name": "mllp 0B inside a frame starts a new one", "preset": "mllp", "reads": ["\u000bA\u000bB\u001c\r"],
      "want": [{ "data": "\u000bA", "incomplete": "new frame" }, { "data": "\u000bB\u001c\r" }] },
    { "name": "mllp ACK byte after a frame", "preset": "mllp", "reads": ["\u000bA\u001c\r\u0006"],
      "want": [{ "data": "\u000bA\u001c\r" }, { "data": "\u0006", "outside": true }] },
    { "name": "mllp silence flushes outside bytes, not a frame", "preset": "mllp", "reads": ["\u0006", null, "\u000bA", null, "\u001c\r"],
      "want": [{ "data": "\u0006", "outside": true }, { "data": "\u000bA\u001c\r" }] },
    { "name": "mllp unfinished frame when disconnected", "preset": "mllp", "reads": ["\u000bAB"], "close": "disconnected",
      "want": [{ "data": "\u000bAB", "incomplete": "disconnected" }] },
    { "name": "mllp outside bytes cut before a start marker", "preset": "mllp", "maxOutside": 2, "reads": ["abc\u000bA\u001c\r"],
      "want": [{ "data": "ab", "outside": true }, { "data": "c", "outside": true }, { "data": "\u000bA\u001c\r" }] },
    { "name": "mllp oversized frame: cut, then dropped up to its end", "preset": "mllp", "maxFrame": 4,
      "reads": ["\u000bABCDEF\u001c\r\u000bG\u001c\r"],
      "want": [{ "data": "\u000bABC", "cut": true }, { "dropped": 5 }, { "data": "\u000bG\u001c\r" }] },
    { "name": "mllp oversized frame ended by a start marker", "preset": "mllp", "maxFrame": 4,
      "reads": ["\u000bABCDE\u000bF\u001c\r"],
      "want": [{ "data": "\u000bABC", "cut": true }, { "dropped": 2 }, { "data": "\u000bF\u001c\r" }] },
    { "name": "mllp end marker across the cut", "preset": "mllp", "maxFrame": 4, "reads": ["\u000bAB\u001c\r"],
      "want": [{ "data": "\u000bAB\u001c", "cut": true }, { "dropped": 1 }] },
    { "name": "mllp frame of exactly maxFrame", "preset": "mllp", "maxFrame": 4, "reads": ["\u000bA\u001c\r"],
      "want": [{ "data": "\u000bA\u001c\r" }] },
    { "name": "stxetx, the second frame unfinished", "preset": "stxetx", "reads": ["\u0002ab\u0003\u0002cd"],
      "want": [{ "data": "\u0002ab\u0003" }, { "data": "\u0002cd", "incomplete": "peer closed" }] },
    { "name": "stxetx oversized frame when the connection ends", "preset": "stxetx", "maxFrame": 4, "reads": ["\u0002abcdef"],
      "want": [{ "data": "\u0002abc", "cut": true }, { "dropped": 3 }] },
    { "name": "lf oversized line", "preset": "lf", "maxFrame": 4, "reads": ["abcdef\nxy\n"],
      "want": [{ "data": "abcd", "cut": true }, { "dropped": 3 }, { "data": "xy\n" }] }
  ],

  "targets": [
    { "host": "10.0.0.5", "port": "2575", "addr": "10.0.0.5:2575" },
    { "host": " lab-analyzer.local ", "port": " 2575 ", "addr": "lab-analyzer.local:2575" },
    { "host": "raspberrypi", "port": "1", "addr": "raspberrypi:1" },
    { "host": "pi.lan.", "port": "65535", "addr": "pi.lan.:65535" },
