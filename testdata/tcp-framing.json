    { "host": "[::1]", "port": "2575", "addr": "[::1]:2575" },
    { "host": "fe80::1%eth0", "port": "2575", "addr": "[fe80::1%eth0]:2575" },
    { "host": "[fe80::1%eth0]", "port": "2575", "addr": "[fe80::1%eth0]:2575" },
    { "host": "fe80::1%12", "port": "2575", "addr": "[fe80::1%12]:2575" },
    { "host": "fe80::1%eth0.100", "port": "2575", "addr": "[fe80::1%eth0.100]:2575" },
    { "host": "fe80::1%x\n2026/10/01 12:00:00 FORGED LINE \u001b[31m", "port": "2575", "error": "host" },
    { "host": "fe80::1%eth 0", "port": "2575", "error": "host" },
    { "host": "fe80::1%", "port": "2575", "error": "host" },
